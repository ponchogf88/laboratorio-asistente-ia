# Entorno: development | production
APP_ENV=development
PORT=8000
DATABASE_PATH=automation_engine/data/automation.db

# Protege POST /webhook/leads con X-Webhook-Secret.
INTERNAL_WEBHOOK_SECRET=replace_with_a_long_random_value

# Copia el signing secret del endpoint creado en Stripe Workbench.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Webhook de n8n/Make/Zapier que crea accesos y mensajes de bienvenida.
ONBOARDING_WEBHOOK_URL=https://automation.example.com/webhook/student-onboarding
ONBOARDING_WEBHOOK_TOKEN=replace_with_a_bearer_token

# Opcional: sincronización de leads hacia CRM/n8n.
LEAD_WEBHOOK_URL=https://automation.example.com/webhook/lead-received
LEAD_WEBHOOK_TOKEN=replace_with_a_bearer_token
