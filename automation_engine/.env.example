# Entorno: development | production
APP_ENV=development
PORT=8000
DATABASE_PATH=automation_engine/data/automation.db

# Protege POST /webhook/leads con X-Webhook-Secret.
INTERNAL_WEBHOOK_SECRET=replace_with_a_long_random_value

# Copia el signing secret del endpoint creado en Stripe Workbench.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Oferta única validada para Fase 1B (monto en centavos: 100000 = MXN $1,000).
PRODUCT_CODE=laboratorio-ia-piloto
PRODUCT_AMOUNT_MINOR=100000
PRODUCT_CURRENCY=MXN
# ID del Payment Link Live autorizado, obtenido desde Stripe Dashboard (plink_...).
STRIPE_PAYMENT_LINK_ID=plink_replace_with_authorized_live_link

# URL pública del aula piloto; no es un secreto ni prueba membresía.
CLASSROOM_JOIN_URL=https://classroom.google.com/c/replace_me

# Opcional: sincronización de leads hacia CRM/n8n.
LEAD_WEBHOOK_URL=https://automation.example.com/webhook/lead-received
LEAD_WEBHOOK_TOKEN=replace_with_a_bearer_token
