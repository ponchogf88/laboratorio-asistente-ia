# Variables de Entorno — Laboratorio Asistente IA / Academia AAA
# Copia este archivo como .env y rellena con tus credenciales reales.
# NUNCA subas el archivo .env a GitHub.

# =====================================================
# GOOGLE GEMINI (Obligatorio)
# Obtén tu clave en: https://aistudio.google.com/apikey
# =====================================================
GEMINI_API_KEY=AIzaSy_TU_CLAVE_REAL_AQUI

# =====================================================
# TELEGRAM (Obligatorio para el Bot SDR)
# Crea tu bot en: https://t.me/BotFather
# =====================================================
TELEGRAM_BOT_TOKEN=123456789:AABBCCdd_tu_token_real_aqui
ADMIN_CHAT_ID=123456789

# =====================================================
# GOOGLE SHEETS (Para CRM de leads)
# ID de tu Google Sheet (en la URL entre /d/ y /edit)
# =====================================================
GOOGLE_SHEETS_ID=1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgVE2upms

# =====================================================
# DISCORD (Para notificaciones de leads VIP)
# Crea un webhook en: Configuración del Canal → Integraciones
# =====================================================
DISCORD_WEBHOOK_LEADS_VIP=https://discord.com/api/webhooks/TU_WEBHOOK_AQUI
DISCORD_WEBHOOK_MARKETING=https://discord.com/api/webhooks/TU_WEBHOOK_MARKETING_AQUI

# =====================================================
# N8N (Si usas n8n Cloud o VPS propio)
# =====================================================
